    "user-tag": {
      "patterns": [
        {
          "comment": "Opening user tag with optional dot/colon separators: <|open|>name<|.|>sub<|close|>",
          "name": "meta.tag.user.llmon",
          "match": "(<\\|open\\|>)([A-Za-z0-9_][A-Za-z0-9_]*(?:(?:<\\|\\.|>|<\\|:\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|close\\|>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.llmon" },
            "2": { "name": "entity.name.tag.user.llmon" },
            "3": { "name": "punctuation.definition.tag.begin.llmon" }
          }
        },
        {
          "comment": "Closing user tag: <|open_end|>name<|close|>",
          "name": "meta.tag.user.end.llmon",
          "match": "(<\\|open_end\\|>)([A-Za-z0-9_][A-Za-z0-9_]*(?:(?:<\\|\\.|>|<\\|:\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|close\\|>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.end.llmon" },
            "2": { "name": "entity.name.tag.user.llmon" },
            "3": { "name": "punctuation.definition.tag.end.llmon" }
          }
        },
        {
          "comment": "Self-closing user tag: <|open|>name<|self_close|>",
          "name": "meta.tag.user.self-closing.llmon",
          "match": "(<\\|open\\|>)([A-Za-z0-9_][A-Za-z0-9_]*(?:(?:<\\|\\.|>|<\\|:\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|self_close\\|>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.llmon" },
            "2": { "name": "entity.name.tag.user.llmon" },
            "3": { "name": "punctuation.definition.tag.end.llmon" }
          }
        }
      ]
    },

    "bare-close-tag": {
      "comment": "Bare closing tag (token-saving form): <|open_end|> with no name/close, closes the innermost open tag",
      "name": "punctuation.definition.tag.end.llmon",
      "match": "<\\|open_end\\|>(?!(?:instruction|instr|data|execution|exec|object|item|list|int|float|bool|none|input|output|[A-Za-z0-9_]))"
    },

    "list-separator": {
      "name": "punctuation.separator.list.llmon",
      "match": "<\\|list-separator\\|>"
    },

    "primitives": {
      "patterns": [
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#keywords" }
      ]
    },

    "string": {
      "name": "string.quoted.double.llmon",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.llmon" }
      },
      "end": "\"",
