    "bool-tag": {
      "patterns": [
        {
          "name": "meta.tag.bool.llmon",
          "match": "(<\\|open\\|>)(bool(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|close\\|>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.bool.llmon" },
            "2": { "name": "entity.name.tag.bool.llmon" },
            "3": { "name": "punctuation.definition.tag.bool.llmon" }
          }
        },
        {
          "name": "meta.tag.bool.end.llmon",
          "match": "(<\\|open_end\\|>)(bool(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|close\\|>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.bool.llmon" },
            "2": { "name": "entity.name.tag.bool.llmon" },
            "3": { "name": "punctuation.definition.tag.bool.llmon" }
          }
        },
        {
          "name": "meta.tag.bool.self-closing.llmon",
          "match": "(<\\|open\\|>)(bool(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|self_close\\|>)",
