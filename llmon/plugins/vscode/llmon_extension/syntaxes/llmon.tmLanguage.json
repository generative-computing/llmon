        {
          "name": "meta.tag.none.llmon",
          "match": "(<\\|open\\|>)(none(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|close\\|>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.none.llmon" },
            "2": { "name": "entity.name.tag.none.llmon" },
            "3": { "name": "punctuation.definition.tag.none.llmon" }
          }
        },
        {
          "name": "meta.tag.none.end.llmon",
          "match": "(<\\|open_end\\|>)(none(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|close\\|>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.none.llmon" },
            "2": { "name": "entity.name.tag.none.llmon" },
            "3": { "name": "punctuation.definition.tag.none.llmon" }
