    },

    "list-tag": {
      "patterns": [
        {
          "name": "meta.tag.list.llmon",
          "match": "(<\\|open\\|>)(list(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|close\\|>)",
