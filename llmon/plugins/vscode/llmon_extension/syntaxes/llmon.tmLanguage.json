          "captures": {
            "1": { "name": "punctuation.definition.tag.data.llmon" },
            "2": { "name": "entity.name.tag.data.llmon" },
            "3": { "name": "punctuation.definition.tag.data.llmon" }
          }
        },
        {
          "comment": "Self-closing data tag",
          "name": "meta.tag.data.self-closing.llmon",
          "match": "(<\\|open\\|>)(data(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|self_close\\|>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.data.llmon" },
            "2": { "name": "entity.name.tag.data.llmon" },
            "3": { "name": "punctuation.definition.tag.data.llmon" }
          }
        }
      ]
    },

