{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LLMON",
  "scopeName": "source.llmon",
  "fileTypes": ["llmon"],

  "foldingStartMarker": "<\\|open\\|>",
  "foldingStopMarker": "<\\|open_end\\|>",

  "patterns": [
    { "include": "#llmon-content" }
  ],

  "repository": {
    "llmon-content": {
      "patterns": [
        { "include": "#instruction-tag" },
        { "include": "#data-tag" },
        { "include": "#exec-tag" },
        { "include": "#object-tag" },
        { "include": "#item-tag" },
        { "include": "#list-tag" },
        { "include": "#int-tag" },
        { "include": "#float-tag" },
        { "include": "#bool-tag" },
        { "include": "#none-tag" },
        { "include": "#input-tag" },
        { "include": "#output-tag" },
        { "include": "#user-tag" },
        { "include": "#bare-close-tag" },
        { "include": "#list-separator" },
        { "include": "#primitives" }
      ]
    },

    "instruction-tag": {
      "patterns": [
        {
          "comment": "Opening instruction tag: <|open|>instr<|:|>label<|close|>",
          "name": "meta.tag.instruction.llmon",
          "match": "(<\\|open\\|>)((?:instruction|instr)(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|close\\|>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.instruction.llmon" },
            "2": { "name": "entity.name.tag.instruction.llmon" },
            "3": { "name": "punctuation.definition.tag.instruction.llmon" }
          }
        },
        {
          "comment": "Closing instruction tag: <|open_end|>instr<|:|>label<|close|>",
          "name": "meta.tag.instruction.end.llmon",
          "match": "(<\\|open_end\\|>)((?:instruction|instr)(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|close\\|>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.instruction.llmon" },
            "2": { "name": "entity.name.tag.instruction.llmon" },
            "3": { "name": "punctuation.definition.tag.instruction.llmon" }
          }
        },
        {
          "comment": "Self-closing instruction tag: <|open|>instr<|self_close|>",
          "name": "meta.tag.instruction.self-closing.llmon",
          "match": "(<\\|open\\|>)((?:instruction|instr)(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|self_close\\|>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.instruction.llmon" },
            "2": { "name": "entity.name.tag.instruction.llmon" },
            "3": { "name": "punctuation.definition.tag.instruction.llmon" }
          }
        }
      ]
    },

    "data-tag": {
      "patterns": [
        {
          "comment": "Opening data tag: <|open|>data<|:|>label<|close|>",
          "name": "meta.tag.data.llmon",
          "match": "(<\\|open\\|>)(data(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|close\\|>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.data.llmon" },
            "2": { "name": "entity.name.tag.data.llmon" },
