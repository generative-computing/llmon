          }
        },
        {
          "name": "meta.tag.int.self-closing.llmon",
          "match": "(<\\|open\\|>)(int(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|self_close\\|>)",
