      "patterns": [
        {
          "name": "meta.tag.input.llmon",
          "match": "(<\\|open\\|>)(input(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|close\\|>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.input.llmon" },
            "2": { "name": "entity.name.tag.input.llmon" },
