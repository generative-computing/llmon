    "int-tag": {
      "patterns": [
        {
          "name": "meta.tag.int.llmon",
          "match": "(<\\|open\\|>)(int(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|close\\|>)",
