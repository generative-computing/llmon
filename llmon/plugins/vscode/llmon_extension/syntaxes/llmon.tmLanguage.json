    "output-tag": {
      "patterns": [
        {
          "name": "meta.tag.output.llmon",
          "match": "(<\\|open\\|>)(output(?:(?:<\\|:\\|>|<\\|\\.\\|>)[A-Za-z0-9_][A-Za-z0-9_]*)*)(<\\|close\\|>)",
