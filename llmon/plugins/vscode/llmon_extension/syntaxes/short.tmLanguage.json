            "2": { "name": "entity.name.tag.instruction.short" },
            "3": { "name": "punctuation.definition.tag.instruction.short" }
          },
          "patterns": [
            { "include": "#short-content" }
          ]
        },
        {
          "name": "meta.tag.instruction.self-closing.short",
