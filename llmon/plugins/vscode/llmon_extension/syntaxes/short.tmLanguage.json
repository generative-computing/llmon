  "foldingStartMarker": "(\\\\[A-Za-z0-9_](?:[A-Za-z0-9._: ]*[A-Za-z0-9._:])?\\\\|\\\\object\\\\|\\\\list\\\\)",
  "foldingStopMarker": "(/(?:[A-Za-z0-9_](?:[A-Za-z0-9._: ]*[A-Za-z0-9._:])?|object|list)/)",

