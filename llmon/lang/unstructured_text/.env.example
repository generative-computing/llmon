# lang/unstructured_text configuration
#
# Copy to `.env` and edit. Every key is optional; the value shown is the default.
# A real environment variable always beats this file, and an explicit argument in
# code beats both. `.env` is gitignored.
#
# Point `LLMON_SEG_DOTENV` at another path to read a different file.

# ---------------------------------------------------------------------------
# What runs by default
# ---------------------------------------------------------------------------

# tagger  — BIO token tagger. The default: it does its own segmentation and is
#           the only backend that finds mid-sentence boundaries reliably. Needs a
#           checkpoint and the [tagger] extra.
# rules   — pure stdlib, no checkpoint, ~0.22 ms/prompt. Under-splits badly, but
#           always available, and the only backend that can emit nine classes.
LLMON_SEG_BACKEND=tagger

# three — instruction / constraint / data. Renders \instr\ \constraint\ \data\.
# nine  — the full annotation taxonomy. Also renders \format\ and \context\.
#         Only the `rules` backend can produce it; the tagger's label space is
#         fixed at training time.
LLMON_SEG_TAXONOMY=three

# ---------------------------------------------------------------------------
# Where the weights live
#
# A local directory wins over a HuggingFace repo id. Leave both blank and the
# library uses the published checkpoint (DEFAULT_TAGGER_REPO in weights.py, once
# one is published), then looks for ./tagger_ckpt, then gives up with
# instructions.
# ---------------------------------------------------------------------------

# Option A — a local directory holding head.pt, tokenizer.json and encoder/
LLMON_SEG_TAGGER_PATH=

# Option B — a HuggingFace repo id, downloaded and cached on first use
LLMON_SEG_TAGGER_REPO=
LLMON_SEG_TAGGER_REVISION=main

# Where downloads are cached. Blank uses the HuggingFace default (~/.cache).
LLMON_SEG_CACHE_DIR=

# ---------------------------------------------------------------------------
# Tuning
#
# These four are MEASURED values, not preferences — see docs/RESULTS.md. Changing
# one without re-running the sweep will move accuracy, usually downward.
# ---------------------------------------------------------------------------

# Below this mean token confidence, a tagger span is flagged for review.
LLMON_SEG_ESCALATION_THRESHOLD=0.60

# Absorb spans of at most this many words into a confident neighbour. Measured
# at +3.3 holdout F1 for -6.1 pt mid-sentence boundary recall; kept.
LLMON_SEG_ABSORB_MAX_WORDS=2
LLMON_SEG_ABSORB_CONFIDENCE=0.60

# Merge adjacent same-class spans above this confidence. 0.0 disables it.
# Measured at +0.5 F1 for -18.2 pt mid-sentence boundary recall, so it ships OFF
# and stays opt-in.
LLMON_SEG_MERGE_THRESHOLD=0.0

# Below this, a rule-derived span is not trusted and comes back flagged.
LLMON_SEG_CONFIDENCE_THRESHOLD=0.8

# Longest prompt, in tokens, that a model backend will read.
LLMON_SEG_MAX_SEQ_LEN=2048

# Torch device for the tagger: cpu, cuda or mps. Blank picks cuda when it is
# available, else cpu.
LLMON_SEG_DEVICE=
